{
  "name": "mariomakesgames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A collection of original browser games by Mario Gerardi.",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:catalog && npm run typecheck && npm run lint && npm run test && npm run build",
    "check:catalog": "node scripts/check-catalog.mjs && node scripts/check-source-lock.mjs",
    "test": "node --test",
    "test:app": "node --test test/app/*.test.mjs",
    "test:contracts": "node --test test/contracts/*.test.mjs",
    "test:legacy": "node --test test/legacy/*.test.mjs",
    "dual:data:download": "node scripts/dual/download-kaikki.mjs",
    "dual:data:frequency": "node scripts/dual/prepare-wordfreq.mjs",
    "dual:data:build": "node --expose-gc --max-old-space-size=4096 scripts/dual/build-kaikki-index.mjs",
    "dual:data": "npm run dual:data:download && npm run dual:data:frequency && npm run dual:data:build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  }
}
