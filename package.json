{
  "name": "mariomakesgames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A collection of original browser games by Mario Gerardi.",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern cdk.out",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:catalog && npm run typecheck && npm run lint && npm run test && npm run build",
    "check:catalog": "node scripts/check-catalog.mjs && node scripts/check-source-lock.mjs",
    "infra:synth": "cdk synth",
    "test": "node --test",
    "test:app": "node --test test/app/*.test.mjs",
    "test:contracts": "node --test test/contracts/*.test.mjs",
    "test:legacy": "node --test test/legacy/*.test.mjs",
    "studio:promote": "node scripts/studio/promote.mjs",
    "dual:data:download": "node scripts/dual/download-kaikki.mjs",
    "dual:data:frequency": "node scripts/dual/prepare-wordfreq.mjs",
    "dual:data:build": "node --expose-gc --max-old-space-size=4096 scripts/dual/build-kaikki-index.mjs",
    "dual:data": "npm run dual:data:download && npm run dual:data:frequency && npm run dual:data:build",
    "build:next": "next build",
    "deploy:aws": "node scripts/deploy-production.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1126.0",
    "@aws-sdk/lib-dynamodb": "^3.1126.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "aws-cdk": "^2.1139.0",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
  "eslint": "10.9.1",
  "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "sst": "^4.17.1",
    "tsx": "^4.23.13",
  "typescript": "7.0.2",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.126.0"
  }
}
